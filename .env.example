# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=verity

# Auth
SECRET_KEY=generate-a-random-64-char-hex-string

# JWT (optional - generate RSA keys for production)
# Run: openssl genrsa -out secrets/jwt_private.pem 2048
# Run: openssl rsa -in secrets/jwt_private.pem -pubout -out secrets/jwt_public.pem

# Sentry (optional)
SENTRY_DSN=

# CORS
CORS_ORIGINS=https://app.yourdomain.com

# LLM — AI-powered answer synthesis (BYOK — bring your own key)
# Supported providers: openai, anthropic, google, groq, together, deepseek,
#   mistral, fireworks, xai, ollama, custom
# View all providers and models: GET /api/v1/llm/providers
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=600

# For LLM_PROVIDER=custom: set LLM_API_BASE to any OpenAI-compatible endpoint
# LLM_API_BASE=https://api.openai.com/v1

# Ollama (local AI — set LLM_PROVIDER=ollama, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# AI Engine
AI_SYNTHESIS_ENABLED=true
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vanta Integration (optional — set VANTA_INTEGRATION_MODE=live to enable)
VANTA_API_KEY=
VANTA_API_BASE=https://api.vanta.com
VANTA_INTEGRATION_MODE=mock

# License
LICENSE_PUBLIC_KEY=           # Ed25519 public key (base64) for license validation

# Telemetry (opt-in)
TELEMETRY_ENABLED=false
